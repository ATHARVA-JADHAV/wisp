# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
#
# IMPORTANT: copy the BARE project URL (https://xxxxxxxx.supabase.co), not the
# REST endpoint ending in /rest/v1/. (src/lib/supabase/url.ts normalises it
# either way, but the bare origin is what you want.)
NEXT_PUBLIC_SUPABASE_URL=

# Public key. Safe in the browser ONLY because row-level security is enabled —
# see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Bypasses ALL row-level security.
# Never prefix this with NEXT_PUBLIC_ — that would inline it into the browser
# bundle and hand every visitor full database access.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Gemini ──────────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com
#
# Accepts MULTIPLE comma-separated keys from different accounts. Wisp rotates to
# the next key on a 429 quota error, so stacking free keys raises your daily
# ceiling:  GEMINI_API_KEY=key_one,key_two,key_three
GEMINI_API_KEY=

# Optional. Prepended to the model fallback chain in src/lib/gemini.ts, which is
# otherwise: gemini-3.1-flash-lite → flash-lite-latest → flash-latest → 2.5-flash.
# The chain exists because fresh Google accounts get a 404 on gemini-2.5-flash.
# GEMINI_CHAT_MODEL=


# ─── App ─────────────────────────────────────────────────────────────────────
# Base URL used to build the embed snippet shown in the dashboard's Widget tab.
# Falls back to window.location.origin when unset, so it's optional locally.
# In production set it to your real domain, e.g. https://wisp-brown.vercel.app
NEXT_PUBLIC_APP_URL=
